# =====================================================================
# vedit — configurare. Copiază în .env și completează:
#     cp .env.example .env && nano .env
# NU pune .env în git (e deja în .gitignore / .dockerignore).
# Liniile comentate (#) au valoarea implicită din cod; decomentează doar ce schimbi.
# =====================================================================

# ---------------------------------------------------------------------
# Domeniu + HTTPS (folosite de Caddy, nu de aplicație)
# ---------------------------------------------------------------------
DOMAIN=vedit.exemplu.ro
# Email pentru Let's Encrypt (te anunță dacă certificatul are probleme)
ACME_EMAIL=tu@exemplu.ro

# ---------------------------------------------------------------------
# Core (aplicația)
# ---------------------------------------------------------------------
# Parola API-ului. OBLIGATORIE pe un server public: fără ea oricine îți folosește serverul.
# Generează una:  openssl rand -hex 32
VEDIT_API_TOKEN=schimba-ma
# Unde stau proiectele + baza SQLite (în Docker e fixat la /data/projects).
# VEDIT_HOME=./vedit_projects
# Adresa și portul serverului (în Docker sunt fixate la 0.0.0.0:8000).
# VEDIT_HOST=127.0.0.1
# VEDIT_PORT=8000
# Mărimea maximă a unui upload, în MB (Caddy acceptă până la ~4200 MB).
# VEDIT_MAX_UPLOAD_MB=4096
# Folderul cu frontend-ul construit și cel cu skill-urile (în Docker: /app/web/dist, /app/skills).
# VEDIT_WEB_DIST=./web/dist
# VEDIT_SKILLS_DIR=./skills
# Căi explicite spre ffmpeg / ffprobe, dacă nu sunt în PATH.
# VEDIT_FFMPEG=/usr/bin/ffmpeg
# VEDIT_FFPROBE=/usr/bin/ffprobe
# Model YuNet alternativ pentru detecția de fețe (implicit cel inclus în pachet).
# VEDIT_FACE_MODEL=/cale/spre/face_detection_yunet.onnx

# ---------------------------------------------------------------------
# Agent / runner
# ---------------------------------------------------------------------
# auto        = Claude Code dacă binarul `claude` există, altfel scripted
# claude-code = `claude -p` pe abonamentul TĂU (doar test personal, vezi docs/DEPLOY.md)
# scripted    = pipeline fix, fără AI (demo / fallback)
VEDIT_RUNNER=scripted
# Model pentru Claude Code (ex. sonnet); gol = cel din setările tale.
# VEDIT_CLAUDE_MODEL=
# Calea spre binarul Claude Code.
# VEDIT_CLAUDE_BIN=claude
# Cât poate rula un job de agent, în secunde, înainte să fie oprit.
# VEDIT_JOB_TIMEOUT=1200
# Cât poate dura un singur tool (ex. o randare finală) în Claude Code, secunde (implicit 900)
# VEDIT_TOOL_TIMEOUT=900
# Plafonul unei randări ffmpeg, secunde (implicit max(300, 40 x durata)); o randare blocată e oprită
# VEDIT_RENDER_TIMEOUT=

# Agentul de PRODUCȚIE (VEDIT_RUNNER=llm): orice API compatibil OpenAI (OpenRouter, Ollama, vLLM, Groq...)
# VEDIT_LLM_BASE_URL=https://openrouter.ai/api/v1      # Ollama local: http://localhost:11434/v1
# VEDIT_LLM_API_KEY=
# VEDIT_LLM_MODEL=                                      # un model cu tool calling, ex. din lista OpenRouter
# VEDIT_LLM_VISION=0                                    # 1 dacă modelul primește imagini (vede cadrele)
# VEDIT_LLM_MAX_TURNS=40
# VEDIT_LLM_TIMEOUT=180                                 # secunde per cerere HTTP
# VEDIT_LLM_HEADERS={"HTTP-Referer": "https://site-ul-tau.ro"}

# ---------------------------------------------------------------------
# Bugete de securitate PER JOB (impuse în vedit/guard.py; nu le crește fără motiv)
# ---------------------------------------------------------------------
# VEDIT_MAX_TOOL_CALLS=200
# VEDIT_MAX_RENDERS=12
# VEDIT_MAX_STOCK_DOWNLOADS=12
# Câte generări AI de B-roll pe proiect (costă bani).
# VEDIT_GEN_LIMIT=3
#
# NU le seta tu: le pune serverul automat pentru fiecare job.
#   VEDIT_PROJECT_LOCK      proiectul la care are voie agentul
#   VEDIT_ALLOW_GENERATION  1 doar dacă utilizatorul a bifat generarea AI

# ---------------------------------------------------------------------
# B-roll din afară: stock + generare AI (opționale)
# ---------------------------------------------------------------------
# Footage stock gratuit: https://www.pexels.com/api/
# PEXELS_API_KEY=
# Generare video AI pe fal.ai (ID-ul modelului din pagina lui)
# FAL_KEY=
# VEDIT_FAL_MODEL=
# Generare pe Replicate (owner/nume)
# REPLICATE_API_TOKEN=
# VEDIT_REPLICATE_MODEL=
# Forțează providerul când ai ambele chei: fal | replicate
# VEDIT_GEN_PROVIDER=
# Parametri extra pentru model, JSON: {"negative_prompt": "text, logo"}
# VEDIT_GEN_EXTRA=
# URL-uri de bază (doar pentru teste / proxy-uri)
# VEDIT_PEXELS_BASE=https://api.pexels.com
# VEDIT_FAL_BASE=https://queue.fal.run
# VEDIT_REPLICATE_BASE=https://api.replicate.com

# ---------------------------------------------------------------------
# Diarizare (pyannote) — doar dacă imaginea e construită cu INSTALL_DIARIZE=1
# Acceptă termenii pe https://hf.co/pyannote/speaker-diarization-community-1
# ---------------------------------------------------------------------
# HF_TOKEN=hf_...
# (alias acceptat: HUGGINGFACE_TOKEN)

# ---------------------------------------------------------------------
# Build Docker (citite de docker-compose.yml)
# ---------------------------------------------------------------------
# 1 = include faster-whisper (transcriere locală, recomandat pentru subtitrări)
INSTALL_WHISPER=0
# 1 = include pyannote + torch CPU (imaginea crește de la ~1.2 GB la ~3.6 GB)
INSTALL_DIARIZE=0
# Limite de resurse pentru container. NU pune mai multe CPU-uri decât are serverul.
VEDIT_CPUS=2
VEDIT_MEMORY=3g

# ---------------------------------------------------------------------
# Conturi + plăți (1 credit = 1 minut început de video exportat final; preview-urile sunt gratuite)
# ---------------------------------------------------------------------
# on = conturi cu email + parolă, fiecare client își vede doar proiectele lui (VEDIT_API_TOKEN e ignorat)
# VEDIT_AUTH=on
# Credite gratuite pentru un cont nou
# VEDIT_FREE_CREDITS=3
# Cât ține o sesiune de login, în zile
# VEDIT_SESSION_DAYS=30
# Plafoane anti-abuz per cont (0 = fără limită): cereri către agent / 24 h și număr de proiecte
# VEDIT_MAX_AGENT_JOBS_PER_DAY=60
# VEDIT_MAX_PROJECTS=50
# Pachetele de vânzare; price_id vine din Stripe (Products → preț)
# VEDIT_PACKS=[{"id":"starter","credits":30,"price_id":"price_...","label":"30 de minute","price":"9 €"}]
# (price e doar textul afișat pe site; suma reală o ia Stripe din price_id)
# Stripe: cheia secretă și secretul webhook-ului (dashboard.stripe.com → Developers)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# URL-ul public al site-ului (pentru redirect-urile Stripe și link-uri în emailuri)
# VEDIT_PUBLIC_URL=https://vedit.exemplu.ro
